  ],
  "phase2": {"rhythms": [{"name": "Cash in", "turns": ["combo", "combo"], "weight": 2}, {"name": "Range in", "turns": ["charge", "combo"], "weight": 1}], "note": "cashes in"},
  "opener": [{"type": "primed", "card": "lock_on"}, {"type": "player_status", "status": "shock", "stacks": 1, "target": "strongest_weapon", "note": "Lock On primed, your best weapon Shocked"}],
  "on_lost": {
