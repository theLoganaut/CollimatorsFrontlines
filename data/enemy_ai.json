{
 "_source": "How each enemy fights (Notion: Dynamic Turn Rework, Phase 4 'Enemy AI Design', Phase 6 build). Keyed by enemy id; read by EnemyAI beside the Refit Bay 'ai' profile in data/mechs/. Refit Bay keeps its format.",
 "_keys": {
  "archetype": "label only (Bruiser, Sniper, Controller, Turtle, Heat-pressure, Support, Scavenger, Pack, Artillery, Driller, Juggernaut)",
  "rhythms": "[{name, turns: [theme, theme], weight, when?}]: a two-turn plan; the first turn is shown, the second held. Themes: assault, guard, charge, afflict, recover, combo. `when` (one condition, or a list: any) triples the weight while it holds",
  "when conditions": "player_hot (the player ended their last turn at 60%+ Heat), player_shielded (Deflect or Absorb up), player_damaged (a part of yours at 60% HP or less), player_primed (you have a protocol waiting), self_hurt (below its profile's guard share), ally_hurt, has_charge (it can charge something), squad (another enemy is alive)",
  "squad_role": "marker (its first target is the squad's mark), striker (aims at the mark), cover (its Redirect Spike covers the most hurt ally), pressure, support",
  "opener": "fight-start setup, one or a list: {type: charged} (turn 1 shows a charged attack), {type: primed, card?} (a protocol waiting), {type: player_status, status, stacks, target: strongest_weapon|most_damaged|any} on your part (or mech, for Smoke), {type: self_status, status, stacks}",
  "on_lost": "{part id: {rhythms?, profile keys?, note}}: what changes once that part is destroyed",
  "phase2": "a boss's rhythms (and note) from half HP",
  "desperate": "parts whose self-Offline cards (Precision Throw) it only plays below this share of HP (default 0.3)"
 },
 "scrap_warden": {
  "archetype": "Scavenger",
  "rhythms": [
