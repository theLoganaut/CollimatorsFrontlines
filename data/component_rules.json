{
 "_note": "Hand-written mechanics for Refit Bay parts, keyed by component id (passives) and card id (cards). Refit Bay text stays verbatim in data/components.json; this file only says how each effect plays. Rulings: Notion Components & Cards, 'Rulings for implementing every Refit Bay part' (Decided) and 'Phase 2 rulings to vet' (Proposed).",
 "_card_keys": {
  "play_mode": "'self' or 'attack', overriding the one derived from hits/statuses",
  "hit_chance": "chance each hit fires, by hit number; the last entry repeats (Logan's falloff: 100/90/70/40/20%)",
  "status_chance": "chance the card's statuses apply",
  "mult_if_target_status": "{status (a name or a list: any of them), mult, hardpoint_only}: damage multiplier if the targeted part has the status (a mech-scoped one, Smoke/Deflect/Absorb, is read on its mech)",
  "mult_if_target_below": "{fraction, mult, hardpoint_only}: damage multiplier if the targeted part is at or below that share of its HP",
  "on_hit_status": "{status, stacks, hardpoint_only}: put on the targeted part after the hits",
  "repeat_turns": "the attack repeats on the same part at the start of the attacker's next N turns (Logan)",
  "self_damage": "the card's damage lands on the part that played it (Self Splash, Logan: 'you take it all')",
  "hits_all_enemies": "every hit also lands on one living part (picked when the card is played) of every other enemy mech",
  "protocol": "a protocol effect; see scripts/combat/CombatProtocols.gd. Card pass: 'grant' (the next card that fits `on` gets the `grant` rule keys for one play; on = attack|self|shield|status), 'steal' (Echo), 'clear_enemy' (Scramble Signal), 'defer_heat' (Batch); 'discount' may carry if_below (Last Stand) and a negative amount (Borrow Time); 'overdrive' now hits every other hardpoint instead of doubling",
  "volley": "presentation only: its hits land all but at once (a salvo of rockets, a shotgun blast), not one by one (Logan, 2026-09-30)",
  "vs_attacking": "{mult?, status?, stacks?, turn?} vs a part attacking this turn (an enemy part with an attack in its shown plan; for enemy cards, a player part that attacked last turn): damage multiplier, a status after the hits, or turn = its attacks this round hit its own mech (card pass, 2026-10-13)",
  "status_if_target_status": "{if, status, stacks}: after the hits, the status lands only if the target holds `if` (Lockout Round, Twist)",
  "bonus_if_target_status": "{status, flat}: +flat damage per hit if the target holds the status (Grind, Rivet)",
  "strip_shields": "removes the target mech's Deflect and Absorb before the hits (Rip Plating)",
  "last_card": "no more cards this turn after it (Drive)",
  "no_hardpoints": "can't be aimed at a hardpoint (Flak)",
  "vent_on_kill": "vent this much if the card destroys its target (Devour)",
  "guard": "{type: parry|static_field|decoy|scatter|thorns|heat_back|cap|floor, ...}: a self card's guard, up until its side's next turn (CombatAttack.self_rules)",
  "status_on_attackers": "{status, stacks}: on every enemy part attacking this turn (Arc Lash)",
  "if_heavy_incoming": "{status, stacks}: extra stacks on the playing side if any enemy shows a heavy attack (Hunker)",
  "heal_lowest": "heals the playing mech's most damaged part (by share of HP) this much (Patch Job)",
  "cleanse": "statuses removed from the playing mech, its parts and (Smoke) the mech itself",
  "sure_hit": "no cover, Decoy/Smoke Screen, dodge, parry or misses (Zero Lock)",
  "all_hardpoints": "also hits every other hardpoint of the target mech (Overdrive)",
  "hits_top_attacker": "also hits the enemy part with the biggest attack shown this turn (Double Tap)",
  "steal_shields": "takes the target mech's Deflect and Absorb for the attacker's mech (Leech Field)",
  "spread_status": "its enemy-targeted part statuses also land on every part adjacent to the target (Chain)",
  "transfer": "with heat_to_target: the attacker loses that much Heat (Heat Transfer)",
  "self_disable": "the part that played it is Disabled 1 after (Ram)",
  "heal_on_kill": "heals the attacker's most damaged part this much if it destroys its target (Scavenge)",
  "swap_statuses": "the firing part and its target trade statuses, Offline excepted (Reverse Polarity)",
  "gift_status": "{status, stacks}: after a hit lands, the target (its mech, for Deflect/Absorb) gains it (Hammer Down, Heavy Round: a tradeoff)"
 },
