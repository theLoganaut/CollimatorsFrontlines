; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Collimators: Frontlines"
run/main_scene="res://scenes/WarRoom.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/data/GameData.gd"
UIState="*res://scripts/ui/UIState.gd"
GameSettings="*res://scripts/ui/GameSettings.gd"
Profile="*res://scripts/run/Profile.gd"
RunState="*res://scripts/run/RunState.gd"
SceneRouter="*res://scripts/core/SceneRouter.gd"
Sfx="*res://scripts/core/Sfx.gd"
Tutorial="*res://scripts/core/Tutorial.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
